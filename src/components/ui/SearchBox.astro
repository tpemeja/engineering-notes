---
---

<button id="search-open" type="button" class="search-trigger" aria-haspopup="dialog">
  <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="11" cy="11" r="7" />
    <path d="m20 20-3.5-3.5" />
  </svg>
  <span>Search</span>
  <kbd>/</kbd>
</button>

<dialog id="search-dialog" aria-label="Site search">
  <div id="search-dialog-results" data-pagefind-ignore></div>
  <p id="search-unavailable" hidden>
    Search index isn't available in dev mode. Run <code>pnpm build</code> to generate it.
  </p>
</dialog>

<style>
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--color-fg-muted);
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .search-trigger:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .search-trigger kbd {
    font-family: var(--font-mono);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    padding: 0 0.3rem;
    font-size: 0.7rem;
  }

  dialog#search-dialog {
    width: min(600px, calc(100vw - 2rem));
    max-height: min(70vh, 560px);
    margin: 10vh auto auto;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background-color: var(--color-bg);
    color: var(--color-fg);
    padding: 1rem;
    overflow-y: auto;
  }

  dialog#search-dialog::backdrop {
    background-color: rgb(0 0 0 / 0.4);
  }

  #search-unavailable {
    color: var(--color-fg-muted);
    font-size: 0.875rem;
  }
</style>

<script is:inline>
  (function () {
    const openButton = document.getElementById('search-open');
    const dialog = document.getElementById('search-dialog');
    let loaded = false;

    async function loadPagefind() {
      if (loaded) return;
      loaded = true;
      try {
        const pagefindUiCss = document.createElement('link');
        pagefindUiCss.rel = 'stylesheet';
        pagefindUiCss.href = '/pagefind/pagefind-ui.css';
        document.head.appendChild(pagefindUiCss);

        const { PagefindUI } = await import(/* @vite-ignore */ '/pagefind/pagefind-ui.js');
        new PagefindUI({ element: '#search-dialog-results', showSubResults: true, showImages: false });
      } catch {
        document.getElementById('search-unavailable')?.removeAttribute('hidden');
      }
    }

    openButton?.addEventListener('click', () => {
      dialog?.showModal();
      loadPagefind();
    });

    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === '/' && document.activeElement?.tagName !== 'INPUT' && !dialog?.open) {
        event.preventDefault();
        dialog?.showModal();
        loadPagefind();
      }
    });
  })();
</script>
