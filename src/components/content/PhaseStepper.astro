---
import type { CollectionEntry } from 'astro:content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  phases: CollectionEntry<'projects'>['data']['phases'];
  headings: Heading[];
}

const { phases, headings } = Astro.props;

const labels = {
  planned: 'Planned',
  'in-progress': 'In progress',
  done: 'Done',
} as const;

const items = phases.map((phase) => ({
  ...phase,
  title: headings.find((heading) => heading.slug === phase.id)?.text ?? phase.id,
}));
---

{
  items.length > 0 && (
    <nav class="not-prose phase-stepper" aria-label="Project phases">
      <div class="phase-stepper-header">
        <p class="phase-stepper-heading">Phases</p>
        {items.length > 1 && (
          <div class="phase-stepper-nav">
            <button type="button" class="phase-stepper-prev" aria-label="Scroll to previous phase">
              &#8249;
            </button>
            <button type="button" class="phase-stepper-next" aria-label="Scroll to next phase">
              &#8250;
            </button>
          </div>
        )}
      </div>
      <ol class="phase-stepper-track" data-carousel-track>
        {items.map((item, i) => (
          <li data-status={item.status}>
            <a href={`#${item.id}`}>
              <span class="phase-stepper-index" aria-hidden="true">{i + 1}</span>
              <span class="phase-stepper-title">{item.title}</span>
              <p class="phase-stepper-summary">{item.summary}</p>
              <span class="phase-stepper-status">{labels[item.status]}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .phase-stepper {
    margin-block: 1.75rem 2.25rem;
  }

  .phase-stepper-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-end: 0.6rem;
  }

  .phase-stepper-heading {
    margin: 0;
    font-weight: 600;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-fg-muted);
  }

  .phase-stepper-nav {
    display: flex;
    gap: 0.35rem;
  }

  .phase-stepper-nav button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    background-color: var(--color-bg);
    color: var(--color-fg-muted);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }

  .phase-stepper-nav button:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .phase-stepper-track {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding-block-end: 0.25rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }

  .phase-stepper-track li {
    flex: 0 0 auto;
    width: min(260px, 85%);
    scroll-snap-align: start;
  }

  .phase-stepper-track a {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background-color: var(--color-bg);
    color: inherit;
    text-decoration: none;
  }

  .phase-stepper-track a:hover {
    border-color: var(--color-accent);
  }

  .phase-stepper-track a:hover .phase-stepper-title {
    color: var(--color-accent);
  }

  .phase-stepper-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 9999px;
    border: 2px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-fg-muted);
  }

  .phase-stepper-title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .phase-stepper-summary {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .phase-stepper-status {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-fg-muted);
    margin-block-start: auto;
  }

  li[data-status='done'] .phase-stepper-index {
    border-color: var(--color-status-completed);
    background-color: var(--color-status-completed);
    color: var(--color-bg);
  }

  li[data-status='in-progress'] .phase-stepper-index {
    border-color: var(--color-status-active);
    color: var(--color-status-active);
  }

  li[data-status='in-progress'] .phase-stepper-status {
    color: var(--color-status-active);
  }

  li[data-status='planned'] .phase-stepper-index {
    border-style: dashed;
    border-color: var(--color-status-draft);
  }
</style>

<script>
  // A project has one stepper, but this stays defensive in case that changes.
  document.querySelectorAll('.phase-stepper').forEach((nav) => {
    const track = nav.querySelector<HTMLElement>('[data-carousel-track]');
    const prev = nav.querySelector<HTMLButtonElement>('.phase-stepper-prev');
    const next = nav.querySelector<HTMLButtonElement>('.phase-stepper-next');
    if (!track || !prev || !next) return;

    const scrollByCard = (direction: 1 | -1) => {
      const card = track.querySelector('li');
      const amount = card ? card.getBoundingClientRect().width + 12 : 200;
      track.scrollBy({ left: direction * amount, behavior: 'smooth' });
    };

    prev.addEventListener('click', () => scrollByCard(-1));
    next.addEventListener('click', () => scrollByCard(1));
  });
</script>
