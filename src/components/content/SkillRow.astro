---
interface Props {
  category: string;
  technologies: string;
}

const { category, technologies } = Astro.props;
---

<li class="skill-row">
  <span class="skill-category">{category}</span>
  <span class="skill-technologies">{technologies}</span>
</li>

<style>
  .skill-row {
    display: flex;
    gap: 1rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--color-border);
  }

  .skill-row:last-child {
    border-bottom: none;
  }

  .skill-category {
    flex: 0 0 12rem;
    font-weight: 600;
  }

  .skill-technologies {
    flex: 1;
    font-size: 0.9375rem;
    color: var(--color-fg-muted);
  }

  @media (max-width: 640px) {
    .skill-row {
      flex-direction: column;
      gap: 0.25rem;
    }

    .skill-category {
      flex-basis: auto;
    }
  }
</style>
