---
// The recruiter strip at the top of a project page: three or four things
// worth knowing before reading a word of the body. Fed from frontmatter.
interface Highlight {
  headline: string;
  detail: string;
  href?: string;
}

interface Props {
  highlights: Highlight[];
}

const { highlights } = Astro.props;
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

{
  highlights.length > 0 && (
    <section class="highlights" aria-labelledby="highlights-label">
      <p id="highlights-label" class="highlights-label">
        Highlights
      </p>
      <ul class="highlights-grid">
        {highlights.map(({ headline, detail, href }) => (
          <li class="highlight">
            {href ? (
              <a
                class="highlight-inner highlight-link"
                href={href}
                {...(isExternal(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <span class="highlight-headline">
                  {headline}
                  <span class="highlight-arrow" aria-hidden="true">
                    {isExternal(href) ? '↗' : '→'}
                  </span>
                </span>
                <span class="highlight-detail">{detail}</span>
              </a>
            ) : (
              <div class="highlight-inner">
                <span class="highlight-headline">{headline}</span>
                <span class="highlight-detail">{detail}</span>
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .highlights {
    margin-bottom: 2.25rem;
  }

  .highlights-label {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-fg-muted);
  }

  .highlights-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.75rem;
  }

  .highlight {
    display: flex;
  }

  .highlight-inner {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-accent);
    border-radius: 0.5rem;
    background-color: var(--color-bg-subtle);
    color: inherit;
    text-decoration: none;
  }

  .highlight-link:hover {
    border-color: var(--color-accent);
  }

  .highlight-headline {
    font-size: 1.25rem;
    font-weight: 650;
    line-height: 1.2;
    color: var(--color-fg);
    font-variant-numeric: tabular-nums;
  }

  .highlight-arrow {
    margin-inline-start: 0.35rem;
    font-size: 0.9rem;
    color: var(--color-accent);
  }

  .highlight-detail {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-fg-muted);
  }
</style>
