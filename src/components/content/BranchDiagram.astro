---
interface Node {
  name: string;
  detail?: string;
}

interface Props {
  source: Node;
  branches: Node[];
  merge: Node;
  branchLabel?: string;
  mergeLabel?: string;
}

const { source, branches, merge, branchLabel, mergeLabel } = Astro.props;
---

<div class="not-prose branch-diagram">
  <div class="branch-node">
    <p class="branch-name">{source.name}</p>
    {source.detail && <p class="branch-detail">{source.detail}</p>}
  </div>

  <div class="branch-arrow">
    <span aria-hidden="true">↓</span>
    {branchLabel && <span class="branch-arrow-label">{branchLabel}</span>}
  </div>

  <div class="branch-row">
    {
      branches.map((b) => (
        <div class="branch-node">
          <p class="branch-name">{b.name}</p>
          {b.detail && <p class="branch-detail">{b.detail}</p>}
        </div>
      ))
    }
  </div>

  <div class="branch-arrow">
    <span aria-hidden="true">↓</span>
    {mergeLabel && <span class="branch-arrow-label">{mergeLabel}</span>}
  </div>

  <div class="branch-node branch-merge">
    <p class="branch-name">{merge.name}</p>
    {merge.detail && <p class="branch-detail">{merge.detail}</p>}
  </div>
</div>

<style>
  .branch-diagram {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-block: 1.5rem;
  }

  .branch-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
  }

  .branch-node {
    width: max-content;
    max-width: 18rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-subtle);
    border-radius: 0.5rem;
    padding: 0.85rem 1.1rem;
  }

  .branch-merge {
    border-color: var(--color-accent);
  }

  .branch-name {
    margin: 0 0 0.3rem 0;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-accent);
  }

  .branch-detail {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-fg-muted);
  }

  .branch-arrow {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.1;
    color: var(--color-fg-muted);
    font-size: 0.9375rem;
    padding-block: 0.4rem;
    text-align: center;
  }

  .branch-arrow span[aria-hidden] {
    font-size: 1.5rem;
  }

  .branch-arrow-label {
    font-style: italic;
    font-size: 0.8125rem;
    max-width: 22rem;
  }
</style>
