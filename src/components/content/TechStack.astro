---
import TagBadge from '../ui/TagBadge.astro';

interface Props {
  notes: Array<{ name: string; context: string }>;
}

const { notes } = Astro.props;
---

{
  notes.length > 0 && (
    <ul class="not-prose tech-stack">
      {notes.map((note) => (
        <li>
          <TagBadge tag={note.name} size="md" />
          <p class="tech-stack-context">{note.context}</p>
        </li>
      ))}
    </ul>
  )
}

<style>
  .tech-stack {
    list-style: none;
    margin: 1.5rem 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .tech-stack li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 0.85rem;
  }

  .tech-stack-context {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
    flex: 1 1 20rem;
  }
</style>
