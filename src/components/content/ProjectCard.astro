---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from '../ui/StatusBadge.astro';
import TagList from './TagList.astro';
import { getPhaseStats } from '../../lib/phases';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, status, technologies } = project.data;
const phaseStats = getPhaseStats(project);
---

<article class="project-card">
  <a href={`/projects/${project.id}/`} class="project-card-link">
    <div class="project-card-header">
      <h3>{title}</h3>
      <StatusBadge status={status} />
    </div>
    <p class="project-card-description">{description}</p>
  </a>
  {
    phaseStats.total > 0 && (
      <p class="project-card-phases">
        {phaseStats.done} of {phaseStats.total} phases done
      </p>
    )
  }
  <TagList tags={technologies} />
</article>

<style>
  .project-card {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background-color: var(--color-bg);
    transition: border-color 0.15s ease;
  }

  .project-card:hover {
    border-color: var(--color-accent);
  }

  .project-card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .project-card-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-card-header h3 {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .project-card-description {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .project-card-phases {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-fg-muted);
  }
</style>
