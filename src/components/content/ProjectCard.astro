---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from '../ui/StatusBadge.astro';
import TagList from './TagList.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, active, technologies, websiteUrl } = project.data;
---

<article class="project-card">
  <a href={`/projects/${project.id}/`} class="project-card-link">
    <div class="project-card-header">
      <h3>{title}</h3>
      {active && <StatusBadge status="active" />}
    </div>
    <p class="project-card-description">{description}</p>
  </a>
  {
    websiteUrl && (
      <a href={websiteUrl} class="project-card-website" rel="noopener noreferrer" target="_blank">
        {new URL(websiteUrl).hostname} &#8599;
      </a>
    )
  }
  <TagList tags={technologies} />
</article>

<style>
  .project-card {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background-color: var(--color-bg);
    transition: border-color 0.15s ease;
  }

  .project-card:hover {
    border-color: var(--color-accent);
  }

  .project-card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .project-card-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-card-header h3 {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .project-card-description {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .project-card-website {
    align-self: flex-start;
    font-size: 0.875rem;
    color: var(--color-accent);
  }
</style>
