---
interface Props {
  variant?: 'decision' | 'lesson' | 'warning' | 'info';
  title?: string;
}

const { variant = 'info', title } = Astro.props;

const config = {
  decision: { label: 'Engineering decision', icon: '◆' },
  lesson: { label: 'Lesson learned', icon: '◇' },
  warning: { label: 'Watch out', icon: '▲' },
  info: { label: 'Note', icon: '●' },
} as const;

const { label, icon } = config[variant];
---

<aside class="not-prose callout" data-variant={variant}>
  <p class="callout-heading">
    <span aria-hidden="true">{icon}</span>
    {title ?? label}
  </p>
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    margin-block: 1.5rem;
    border-left: 3px solid var(--color-border);
    background-color: var(--color-bg-subtle);
    padding: 0.9rem 1.1rem;
    border-radius: 0.25rem;
    font-size: 0.9375rem;
  }

  .callout[data-variant='decision'] {
    border-left-color: var(--color-accent);
  }

  .callout[data-variant='lesson'] {
    border-left-color: var(--color-status-active);
  }

  .callout[data-variant='warning'] {
    border-left-color: var(--color-status-paused);
  }

  .callout-heading {
    margin: 0 0 0.4rem 0;
    font-weight: 600;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-fg-muted);
  }

  .callout-body {
    color: var(--color-fg);
  }

  .callout-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
