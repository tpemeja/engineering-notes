---
interface Props {
  name: string;
  issuer: string;
  url: string;
}

const { name, issuer, url } = Astro.props;
---

<li class="cert-row">
  <span class="cert-name">{name}</span>
  <span class="cert-meta">
    {issuer} · <a href={url} rel="noopener noreferrer" target="_blank">Verify</a>
  </span>
</li>

<style>
  .cert-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--color-border);
  }

  .cert-row:last-child {
    border-bottom: none;
  }

  .cert-name {
    font-weight: 600;
  }

  .cert-meta {
    font-size: 0.875rem;
    color: var(--color-fg-muted);
  }

  .cert-meta a {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .cert-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
