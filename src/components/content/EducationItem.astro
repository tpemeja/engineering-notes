---
interface Props {
  degree: string;
  institution: string;
  years: string;
}

const { degree, institution, years } = Astro.props;
---

<li class="edu-row">
  <span class="edu-degree">{degree}</span>
  <span class="edu-meta">{institution} · {years}</span>
</li>

<style>
  .edu-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--color-border);
  }

  .edu-row:last-child {
    border-bottom: none;
  }

  .edu-degree {
    font-weight: 600;
  }

  .edu-meta {
    font-size: 0.875rem;
    color: var(--color-fg-muted);
  }

  @media (max-width: 640px) {
    .edu-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
