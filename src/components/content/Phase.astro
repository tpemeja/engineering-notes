---
import { PHASE_STATUS_LABELS, type PhaseStatus } from '../../lib/phases';

interface Props {
  id: string;
  title: string;
  status: PhaseStatus;
  goal: string;
  outcome: string;
}

const { id, title, status, goal, outcome } = Astro.props;
---

<details class="phase" id={id} data-status={status}>
  <summary class="phase-row not-prose">
    <span class="phase-marker" aria-hidden="true" />
    <span class="phase-heading">
      <span class="phase-title">{title}</span>
      <span class="phase-status" data-status={status}>{PHASE_STATUS_LABELS[status]}</span>
    </span>
    <span class="phase-outcome">{outcome}</span>
  </summary>
  <div class="phase-body">
    <p class="phase-goal"><span class="phase-label">Goal</span>{goal}</p>
    <div class="phase-approach">
      <slot />
    </div>
  </div>
</details>

<style>
  .phase {
    border-block-end: 1px solid var(--color-border);
    scroll-margin-top: 5rem;
  }

  .phase:last-child {
    border-block-end: none;
  }

  .phase-row {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 0.15rem 0.7rem;
    padding: 0.85rem 0.25rem;
    cursor: pointer;
    list-style: none;
  }

  .phase-row::-webkit-details-marker {
    display: none;
  }

  .phase-row:hover .phase-title {
    color: var(--color-accent);
  }

  .phase-marker {
    position: relative;
    width: 0.85rem;
    height: 0.85rem;
    align-self: center;
    grid-row: span 2;
  }

  /* Status dot, swapped for a disclosure chevron on hover/open. */
  .phase-marker::before {
    content: '';
    position: absolute;
    inset: 0.175rem;
    border-radius: 9999px;
    background-color: var(--color-status-draft);
  }

  .phase[data-status='done'] .phase-marker::before {
    background-color: var(--color-status-completed);
  }

  .phase[data-status='in-progress'] .phase-marker::before {
    background-color: var(--color-status-active);
  }

  .phase[data-status='planned'] .phase-marker::before {
    background-color: transparent;
    box-shadow: inset 0 0 0 1.5px var(--color-status-draft);
  }

  .phase-heading {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .phase-title {
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-fg);
  }

  .phase-status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-status-draft);
  }

  .phase-status[data-status='done'] {
    color: var(--color-status-completed);
  }

  .phase-status[data-status='in-progress'] {
    color: var(--color-status-active);
  }

  .phase-outcome {
    grid-column: 2;
    color: var(--color-fg-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .phase-body {
    padding: 0.25rem 0.25rem 1.5rem;
    margin-inline-start: 1.55rem;
  }

  .phase-goal {
    margin: 0 0 1rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-fg);
  }

  .phase-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-fg-muted);
    margin-inline-end: 0.5rem;
  }
</style>
