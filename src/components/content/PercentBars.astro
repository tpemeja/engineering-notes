---
interface Bar {
  label: string;
  value: number;
  highlight?: boolean;
}

interface Props {
  bars: Bar[];
  title?: string;
}

const { bars, title } = Astro.props;
const fmt = (v: number) => `${(v * 100).toFixed(1)}%`;
---

<div class="not-prose pct-bars">
  {title && <p class="pct-title">{title}</p>}
  {
    bars.map((b) => (
      <div class="pct-row">
        <p class="pct-label">{b.label}</p>
        <div class="pct-track">
          <div
            class:list={['pct-fill', { 'pct-fill-highlight': b.highlight }]}
            style={`width: ${(b.value * 100).toFixed(2)}%`}
          />
        </div>
        <p class="pct-value">{fmt(b.value)}</p>
      </div>
    ))
  }
</div>

<style>
  .pct-bars {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-block: 1.25rem;
  }

  .pct-bars + .pct-bars {
    margin-top: -0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .pct-title {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-fg-muted);
  }

  .pct-row {
    display: grid;
    grid-template-columns: minmax(9rem, auto) 1fr minmax(3rem, auto);
    align-items: center;
    column-gap: 1rem;
  }

  .pct-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-fg);
    white-space: nowrap;
  }

  .pct-track {
    height: 0.6rem;
    border-radius: 999px;
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }

  .pct-fill {
    height: 100%;
    border-radius: 999px;
    background-color: var(--color-fg-muted);
  }

  .pct-fill-highlight {
    background-color: var(--color-accent);
  }

  .pct-value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    text-align: right;
  }
</style>
