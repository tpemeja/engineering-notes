---
import type { TimelineEntry } from '../../lib/collections';
import TimelineItem from './TimelineItem.astro';

interface Props {
  items: TimelineEntry[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <ol class="timeline not-prose">
      {items.map((item) => (
        <TimelineItem item={item} />
      ))}
    </ol>
  )
}

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
