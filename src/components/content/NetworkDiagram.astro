---
interface Layer {
  label: string;
  size: number;
  detail?: string;
}

interface Props {
  layers: Layer[];
  maxNodes?: number;
  caption?: string;
}

const { layers, maxNodes = 8, caption } = Astro.props as Props;

const width = 640;
const height = 220;
const marginX = 56;
const marginY = 22;
const plotW = width - marginX * 2;
const layerGap = layers.length > 1 ? plotW / (layers.length - 1) : 0;

interface NodePos {
  cx: number;
  cy: number;
  ellipsis?: boolean;
}

const maxSize = Math.max(...layers.map((l) => l.size));

const layerNodes: NodePos[][] = layers.map((layer, i) => {
  const cx = marginX + i * layerGap;
  // Node count is drawn proportional to the layer's actual size (relative to
  // the largest layer), not just capped at maxNodes, so a layer twice the
  // size of another visibly draws twice the dots instead of looking the same.
  const shown =
    layer.size <= 2 ? layer.size : Math.max(2, Math.round((layer.size / maxSize) * maxNodes));
  const overflow = layer.size > shown;
  const usableH = height - marginY * 2;

  if (!overflow) {
    const step = shown > 1 ? usableH / (shown - 1) : 0;
    const startY = shown > 1 ? marginY : height / 2;
    return Array.from({ length: shown }, (_, j) => ({ cx, cy: startY + j * step }));
  }

  // A big layer reads as "a group of dots, a gap, another group of dots"
  // rather than dots with a trailing mark, so the "there's more in between"
  // ellipsis sits centered in the column, splitting the drawn dots evenly
  // above and below it.
  const topCount = Math.ceil(shown / 2);
  const bottomCount = shown - topCount;
  const totalSlots = shown + 1;
  const step = usableH / (totalSlots - 1);
  const nodes: NodePos[] = [];
  for (let j = 0; j < topCount; j++) nodes.push({ cx, cy: marginY + j * step });
  nodes.push({ cx, cy: marginY + topCount * step, ellipsis: true });
  for (let j = 0; j < bottomCount; j++) nodes.push({ cx, cy: marginY + (topCount + 1 + j) * step });
  return nodes;
});

interface Edge {
  x1: number;
  y1: number;
  x2: number;
  y2: number;
}

const edges: Edge[] = [];
for (let i = 0; i < layerNodes.length - 1; i++) {
  for (const a of layerNodes[i]) {
    if (a.ellipsis) continue;
    for (const b of layerNodes[i + 1]) {
      if (b.ellipsis) continue;
      edges.push({ x1: a.cx, y1: a.cy, x2: b.cx, y2: b.cy });
    }
  }
}

const ariaLabel = `Network diagram: ${layers.map((l) => l.size).join(' → ')}`;
---

<div class="not-prose network-diagram">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={ariaLabel}>
    {edges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} class="network-edge" />
    ))}
    {layerNodes.map((nodes, i) => (
      <g>
        {nodes.map((n) =>
          n.ellipsis ? (
            <text x={n.cx} y={n.cy} text-anchor="middle" class="network-ellipsis">
              ⋮
            </text>
          ) : (
            <circle
              cx={n.cx}
              cy={n.cy}
              r={i === layerNodes.length - 1 ? 7 : 5}
              class={i === layerNodes.length - 1 ? 'network-node network-node-output' : 'network-node'}
            />
          )
        )}
      </g>
    ))}
  </svg>
  <div class="network-layers" style={`--layer-count: ${layers.length}`}>
    {
      layers.map((layer) => (
        <div class="network-layer-label">
          <p class="network-layer-name">
            {layer.label} <span class="network-layer-size">({layer.size})</span>
          </p>
          {layer.detail && <p class="network-layer-detail">{layer.detail}</p>}
        </div>
      ))
    }
  </div>
  {caption && <p class="network-caption">{caption}</p>}
</div>

<style>
  .network-diagram {
    margin-block: 1.5rem;
  }

  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .network-edge {
    stroke: var(--color-fg-muted);
    stroke-width: 0.75;
    opacity: 0.4;
  }

  .network-node {
    fill: var(--color-bg-subtle);
    stroke: var(--color-fg-muted);
    stroke-width: 1.25;
  }

  .network-node-output {
    fill: var(--color-accent);
    stroke: var(--color-accent);
  }

  .network-ellipsis {
    fill: var(--color-fg-muted);
    font-size: 14px;
    dominant-baseline: central;
  }

  .network-layers {
    display: grid;
    grid-template-columns: repeat(var(--layer-count), 1fr);
    gap: 0.5rem;
    margin-top: 0.5rem;
    text-align: center;
  }

  .network-layer-name {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--color-fg);
  }

  .network-layer-size {
    font-weight: 400;
    color: var(--color-fg-muted);
  }

  .network-layer-detail {
    margin: 0.15rem 0 0 0;
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--color-fg-muted);
  }

  .network-caption {
    margin: 0.75rem 0 0 0;
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    text-align: center;
  }

  @media (max-width: 32rem) {
    .network-layers {
      grid-template-columns: 1fr;
    }
  }
</style>
