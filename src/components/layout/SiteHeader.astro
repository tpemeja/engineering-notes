---
import { nav, site } from '../../data/site';
import NavLink from './NavLink.astro';
import MobileNav from './MobileNav.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import SearchBox from '../ui/SearchBox.astro';
---

<header class="site-header" data-pagefind-ignore>
  <div class="site-header-inner">
    <a href="/" class="wordmark">{site.title}</a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <NavLink href={item.href} label={item.label} />
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <SearchBox />
      <ThemeToggle />
      <MobileNav />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 40;
    background-color: color-mix(in oklab, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(6px);
  }

  .site-header-inner {
    max-width: 72rem;
    margin-inline: auto;
    padding: 0.85rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-fg);
    text-decoration: none;
    font-size: 1rem;
  }

  .primary-nav {
    flex: 1;
  }

  .primary-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  @media (max-width: 768px) {
    .primary-nav {
      display: none;
    }

    .header-actions :global(.search-trigger span),
    .header-actions :global(.search-trigger kbd) {
      display: none;
    }
  }
</style>
