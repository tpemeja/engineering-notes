---
import { site } from '../../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="site-footer-inner">
    <p>&copy; {year} {site.author}. Built in public.</p>
    <ul class="footer-links">
      <li><a href={site.socials.github} rel="noopener noreferrer" target="_blank">GitHub</a></li>
      <li><a href={site.socials.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a></li>
      <li><a href={`mailto:${site.socials.email}`}>Email</a></li>
      <li><a href="/sitemap-index.xml">Sitemap</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
  }

  .site-footer-inner {
    max-width: 72rem;
    margin-inline: auto;
    padding: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-fg-muted);
    font-size: 0.875rem;
  }

  .site-footer-inner p {
    margin: 0;
  }

  .footer-links {
    list-style: none;
    display: flex;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
  }

  .footer-links a {
    color: var(--color-fg-muted);
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }
</style>
