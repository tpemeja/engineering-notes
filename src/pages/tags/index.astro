---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../lib/tags';

const tags = await getAllTags();
---

<BaseLayout title="Tags" description="Browse all projects, journal entries, and notes by tag.">
  <div class="page-container">
    <header class="page-header">
      <h1>Tags</h1>
      <p>Every tag used across projects, journal entries, and notes.</p>
    </header>
    <ul class="tag-cloud">
      {
        tags.map((tag) => (
          <li>
            <a href={`/tags/${tag.slug}/`}>
              {tag.label} <span class="tag-count">{tag.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 42rem;
    margin-inline: auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .page-header {
    margin-bottom: 1.5rem;
  }

  .page-header h1 {
    margin: 0 0 0.5rem 0;
    font-size: 1.75rem;
  }

  .page-header p {
    margin: 0;
    color: var(--color-fg-muted);
  }

  .tag-cloud {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .tag-cloud a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    padding: 0.4rem 0.8rem;
    text-decoration: none;
    color: var(--color-fg);
    font-size: 0.875rem;
  }

  .tag-cloud a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .tag-count {
    color: var(--color-fg-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
</style>
