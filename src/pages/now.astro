---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Timeline from '../components/content/Timeline.astro';
import { getTimeline } from '../lib/collections';

const entry = await getEntry('pages', 'now');
if (!entry) throw new Error('Missing src/content/pages/now.mdx');
const { Content } = await render(entry);
const timeline = await getTimeline();
---

<PageLayout title={entry.data.title} description={entry.data.description} updatedDate={entry.data.updatedDate}>
  <Content />

  <h2 class="not-prose timeline-heading">Timeline</h2>
  <Timeline items={timeline} />
</PageLayout>

<style>
  .timeline-heading {
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-fg-muted);
  }
</style>
