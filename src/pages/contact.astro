---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../data/site';
---

<PageLayout title="Contact" description="Get in touch.">
  <p>
  The easiest way to reach me is by email:
  {' '}<a href={`mailto:${site.socials.email}`}>{site.socials.email}</a>.
  </p>
  <p>
  If you're curious about what I'm currently building, have a look at my <a href={site.socials.github} rel="noopener noreferrer" target="_blank">GitHub</a>. 
  If you spot something interesting, feel free to open an issue or a pull request. 
  </p>
  <p>
  You can also connect with me on{' '}
  <a href={site.socials.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>.
  </p>
</PageLayout>
