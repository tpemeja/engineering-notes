---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, site } from '../data/site';

const { email, linkedin, github } = site.socials;

// Shown under each card's title, so the visitor sees where a link goes.
const handle = (url: string) => new URL(url).pathname.replace(/^\/|\/$/g, '');

const links = [
  {
    label: 'LinkedIn',
    handle: handle(linkedin),
    detail: 'My professional background and experience.',
    href: linkedin,
    icon: 'linkedin',
  },
  {
    label: 'GitHub',
    handle: handle(github),
    detail: "What I'm currently building. If you spot something interesting, feel free to open an issue or a pull request.",
    href: github,
    icon: 'github',
  },
  {
    label: 'Resume',
    handle: 'resume',
    detail: 'My experience and skills, with a PDF to download.',
    href: '/resume/',
    icon: 'resume',
  },
] as const;

const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<BaseLayout title="Contact" description="Get in touch by email, or find me on LinkedIn and GitHub.">
  <div class="page-container">
    <header class="contact-header">
      <h1>Contact</h1>
      <p class="contact-lead">The easiest way to reach me is by email.</p>
      <p class="contact-location">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21Z" />
          <circle cx="12" cy="9.5" r="2.5" />
        </svg>
        {profile.location}
      </p>
    </header>

    <section class="email-card" aria-label="Email">
      <span class="contact-icon email-card-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
      </span>
      <div class="email-card-text">
        <p class="email-card-label">Email</p>
        <a class="email-card-address" href={`mailto:${email}`}>{email}</a>
      </div>
      <div class="email-card-actions">
        <a class="button button-primary" href={`mailto:${email}`}>Send an email</a>
        <button type="button" class="button copy-email" data-email={email}>
          <svg class="copy-icon" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="8" y="8" width="14" height="14" rx="2" />
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
          </svg>
          <svg class="check-icon" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 9 17l-5-5" />
          </svg>
          <span class="copy-label">Copy</span>
        </button>
      </div>
    </section>

    <ul class="contact-links">
      {
        links.map(({ label, handle, detail, href, icon }) => (
          <li>
            <a
              class="contact-link"
              href={href}
              {...(isExternal(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class="contact-link-top">
                <span class="contact-icon" aria-hidden="true">
                  {icon === 'linkedin' && (
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                      <rect x="2" y="9" width="4" height="12" />
                      <circle cx="4" cy="4" r="2" />
                    </svg>
                  )}
                  {icon === 'github' && (
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                      <path d="M9 18c-4.51 2-5-2-7-2" />
                    </svg>
                  )}
                  {icon === 'resume' && (
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                      <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                      <path d="M16 13H8" />
                      <path d="M16 17H8" />
                      <path d="M10 9H8" />
                    </svg>
                  )}
                </span>
                <span class="contact-link-arrow" aria-hidden="true">{isExternal(href) ? '↗' : '→'}</span>
              </span>
              <span class="contact-link-label">{label}</span>
              <span class="contact-link-handle">{handle}</span>
              <span class="contact-link-detail">{detail}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<script>
  // Copy the address, then confirm on the button for a moment. If the
  // clipboard is unavailable the mailto link still works, so fail quietly.
  for (const button of document.querySelectorAll<HTMLButtonElement>('.copy-email')) {
    const label = button.querySelector('.copy-label');
    let reset: ReturnType<typeof setTimeout> | undefined;

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.email ?? '');
      } catch {
        return;
      }
      button.dataset.copied = 'true';
      if (label) label.textContent = 'Copied';
      clearTimeout(reset);
      reset = setTimeout(() => {
        delete button.dataset.copied;
        if (label) label.textContent = 'Copy';
      }, 2000);
    });
  }
</script>

<style>
  .page-container {
    max-width: 64rem;
    margin-inline: auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  /* Header, in the style of the Projects and Experience pages */

  .contact-header {
    margin-bottom: 2rem;
  }

  .contact-header h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .contact-lead {
    margin: 0 0 0.75rem;
    max-width: 40rem;
    color: var(--color-fg-muted);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .contact-location {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9375rem;
    color: var(--color-fg-muted);
  }

  /* Shared icon tile */

  .contact-icon {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.6rem;
    background-color: color-mix(in oklab, var(--color-accent) 14%, transparent);
    color: var(--color-accent);
  }

  /* Email */

  .email-card {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem 1.5rem;
    padding: 1.5rem 1.75rem;
    border: 1px solid color-mix(in oklab, var(--color-accent) 35%, var(--color-border));
    border-radius: 1rem;
    background:
      radial-gradient(120% 140% at 0% 0%, color-mix(in oklab, var(--color-accent) 12%, transparent), transparent 60%),
      var(--color-bg-subtle);
  }

  .email-card-icon {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.8rem;
  }

  .email-card-text {
    flex: 1 1 16rem;
    min-width: 0;
  }

  .email-card-label {
    margin: 0 0 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-fg-muted);
  }

  .email-card-address {
    font-size: clamp(1.25rem, 3vw, 1.625rem);
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .email-card-address:hover {
    color: var(--color-accent);
  }

  .email-card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .copy-email {
    cursor: pointer;
    background-color: var(--color-bg);
    font-family: inherit;
  }

  .copy-email .check-icon,
  .copy-email[data-copied] .copy-icon {
    display: none;
  }

  .copy-email[data-copied] .check-icon {
    display: inline;
  }

  .copy-email[data-copied] {
    border-color: var(--color-status-active);
    color: var(--color-status-active);
  }

  /* Other ways in */

  .contact-links {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .contact-links li {
    display: flex;
  }

  .contact-link {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.25rem 1.25rem 1.35rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background-color: var(--color-bg-subtle);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .contact-link:hover,
  .contact-link:focus-visible {
    border-color: var(--color-accent);
    box-shadow: 0 12px 32px -16px color-mix(in oklab, var(--color-fg) 35%, transparent);
    transform: translateY(-2px);
  }

  .contact-link-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }

  .contact-link-arrow {
    font-size: 1.1rem;
    color: var(--color-fg-muted);
    transition: color 0.15s ease;
  }

  .contact-link:hover .contact-link-arrow {
    color: var(--color-accent);
  }

  .contact-link-label {
    font-size: 1.125rem;
    font-weight: 650;
  }

  .contact-link-handle {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
  }

  .contact-link-detail {
    margin-top: 0.35rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-fg-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-link {
      transition: none;
    }

    .contact-link:hover,
    .contact-link:focus-visible {
      transform: none;
    }
  }

  @media (max-width: 720px) {
    .contact-links {
      grid-template-columns: minmax(0, 1fr);
    }

    .email-card {
      padding: 1.25rem;
    }
  }
</style>
