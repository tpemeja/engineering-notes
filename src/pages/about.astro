---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import ReadingListItem from '../components/content/ReadingListItem.astro';
import { readingList } from '../data/reading-list';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing src/content/pages/about.mdx');
const { Content } = await render(entry);
---

<PageLayout title={entry.data.title} description={entry.data.description} updatedDate={entry.data.updatedDate}>
  <Content />

  <h2 class="not-prose reading-list-heading">Reading list</h2>
  <ul class="not-prose reading-list">
    {readingList.map((item) => <ReadingListItem entry={item} />)}
  </ul>
</PageLayout>

<style>
  .reading-list-heading {
    margin-top: 2.5rem;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-fg-muted);
  }

  .reading-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
