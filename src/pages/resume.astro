---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../data/site';

const entry = await getEntry('pages', 'resume');
if (!entry) throw new Error('Missing src/content/pages/resume.mdx');
const { Content } = await render(entry);

const downloadName = `${site.author.replace(/\s+/g, '-')}-Resume.pdf`;
---

<PageLayout title={entry.data.title} description={entry.data.description} updatedDate={entry.data.updatedDate}>
  {
    entry.data.pdfUrl && (
      <p class="not-prose">
        <a href={entry.data.pdfUrl} class="pdf-download" download={downloadName}>
          Download PDF
        </a>
      </p>
    )
  }
  <Content />
</PageLayout>

<style>
  .pdf-download {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    padding: 0.5rem 0.9rem;
    text-decoration: none;
    color: var(--color-fg);
    font-size: 0.9375rem;
  }

  .pdf-download:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
