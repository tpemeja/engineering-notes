---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../data/site';

const entry = await getEntry('pages', 'resume');
if (!entry) throw new Error('Missing src/content/pages/resume.mdx');
const { Content } = await render(entry);

const downloadName = `${site.author.replace(/\s+/g, '-')}-Resume.pdf`;
---

<PageLayout title={entry.data.title} description={entry.data.description} updatedDate={entry.data.updatedDate} wide>
  {
    entry.data.pdfUrl && (
      <a slot="header-action" href={entry.data.pdfUrl} class="pdf-download not-prose" download={downloadName}>
        Download PDF
      </a>
    )
  }
  <Content />
</PageLayout>

<style>
  .pdf-download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--color-accent);
    border-radius: 0.5rem;
    padding: 0.65rem 1.25rem;
    text-decoration: none;
    background-color: var(--color-accent);
    color: var(--color-accent-fg);
    font-size: 1rem;
    font-weight: 600;
    transition: opacity 0.15s ease;
  }

  .pdf-download:hover {
    opacity: 0.85;
  }
</style>
