---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryFilter from '../../components/ui/CategoryFilter.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import { getPublishedNotes } from '../../lib/collections';
import { formatDateShort } from '../../lib/dates';
import { slugifyTag } from '../../lib/tags';
import { NOTE_CATEGORIES } from '../../content.config';

const notes = await getPublishedNotes();

// Biggest category first; ties keep NOTE_CATEGORIES order.
const categories = NOTE_CATEGORIES.map((category) => ({
  label: category,
  slug: slugifyTag(category),
  count: notes.filter((note) => note.data.category === category).length,
}))
  .filter(({ count }) => count > 0)
  .sort((a, b) => b.count - a.count);
---

<BaseLayout
  title="Notes"
  description="Technical notes from building things: what I ran into, why it happened, and the rule of thumb I took away."
>
  <div class="page-container">
    <header class="page-header">
      <h1>Notes</h1>
      <p>
        Things I ran into while building, written up so they're easy to find
        again: what happened, why, and the rule of thumb I took away.
      </p>
      <CategoryFilter label="Filter notes by category" categories={categories} total={notes.length} items=".note-item" />
    </header>

    <ol class="note-list">
      {
        notes.map((note) => {
          const { title, summary, category, lastUpdated, status } = note.data;
          return (
            <li class="note-item" data-category={slugifyTag(category)}>
              <p class="note-meta">
                <time datetime={lastUpdated.toISOString()}>{formatDateShort(lastUpdated)}</time>
                <span class="note-category">{category}</span>
                {status === 'draft' && <StatusBadge status={status} />}
              </p>
              <div>
                <h2>
                  <a href={`/notes/${note.id}/`}>{title}</a>
                </h2>
                <p class="note-summary">{summary}</p>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 72rem;
    margin-inline: auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  .page-header h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .page-header p {
    max-width: 40rem;
    margin: 0 0 1.5rem;
    color: var(--color-fg-muted);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .note-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 56rem;
    border-top: 1px solid var(--color-border);
  }

  .note-item {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .note-item[hidden] {
    display: none;
  }

  .note-meta {
    margin: 0.2rem 0 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-fg-muted);
  }

  .note-category {
    color: var(--color-accent);
  }

  .note-item h2 {
    margin: 0 0 0.4rem;
    font-size: 1.1875rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .note-item h2 a {
    color: inherit;
    text-decoration: none;
  }

  .note-item h2 a:hover {
    color: var(--color-accent);
  }

  .note-summary {
    margin: 0;
    max-width: 44rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-fg-muted);
  }

  @media (max-width: 640px) {
    .note-item {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }

    .note-meta {
      flex-direction: row;
      gap: 0.75rem;
    }
  }
</style>
