---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectTile from '../../components/content/ProjectTile.astro';
import { getPublishedProjects } from '../../lib/collections';
import { slugifyTag } from '../../lib/tags';
import { PROJECT_CATEGORIES } from '../../content.config';
import { profile } from '../../data/site';

const published = await getPublishedProjects();

// The home page's featured projects lead, in the same order; the rest follow
// by `order`.
const featuredSlugs: readonly string[] = profile.featuredProjects;
const projects = [
  ...featuredSlugs
    .map((slug) => published.find((project) => project.id === slug))
    .filter((project) => project !== undefined),
  ...published.filter((project) => !featuredSlugs.includes(project.id)),
];

const categories = PROJECT_CATEGORIES.map((category) => ({
  category,
  slug: slugifyTag(category),
  count: projects.filter((project) => project.data.category === category).length,
})).filter(({ count }) => count > 0);
---

<BaseLayout
  title="Projects"
  description="Software engineering projects, documented as they're built: problem, solution, architecture, and lessons learned."
>
  <div class="page-container">
    <header class="page-header">
      <h1>Projects</h1>
      <p>
        Things I've built outside work, from serverless backends to voice AI
        and game-playing agents. Each page covers the problem, the approach,
        what shipped and what I measured, written as the work happens rather
        than after the fact.
      </p>
      <div class="category-filters" role="group" aria-label="Filter by category">
        <button type="button" aria-pressed="true" data-filter="">
          All <span>{projects.length}</span>
        </button>
        {
          categories.map(({ category, slug, count }) => (
            <button type="button" aria-pressed="false" data-filter={slug}>
              {category} <span>{count}</span>
            </button>
          ))
        }
      </div>
    </header>

    <div class="project-grid">
      {projects.map((project) => <ProjectTile project={project} />)}
    </div>
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.category-filters button');
  const tiles = document.querySelectorAll<HTMLElement>('.project-tile');

  function show(category: string) {
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(button.dataset.filter === category));
    }
    for (const tile of tiles) {
      tile.hidden = category !== '' && tile.dataset.category !== category;
    }
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const category = button.dataset.filter ?? '';
      show(category);
      // Keeps a filtered view linkable, the same way project pages link here.
      history.replaceState(null, '', category ? `#${category}` : location.pathname);
    });
  }

  // A project page's breadcrumb links here as /projects/#<category>.
  function showHash() {
    const category = decodeURIComponent(location.hash.slice(1));
    if ([...buttons].some((button) => button.dataset.filter === category)) show(category);
  }

  showHash();
  window.addEventListener('hashchange', showHash);
</script>

<style>
  .page-container {
    max-width: 72rem;
    margin-inline: auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  .page-header h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .page-header p {
    max-width: 40rem;
    margin: 0 0 1.5rem;
    color: var(--color-fg-muted);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .category-filters button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background-color: var(--color-bg-subtle);
    color: var(--color-fg);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .category-filters button:hover {
    border-color: var(--color-accent);
  }

  .category-filters button[aria-pressed='true'] {
    border-color: var(--color-fg);
    background-color: var(--color-fg);
    color: var(--color-bg);
  }

  .category-filters span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: 1rem;
  }
</style>
