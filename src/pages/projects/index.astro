---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/content/ProjectCard.astro';
import { getPublishedProjects } from '../../lib/collections';
import { slugifyTag } from '../../lib/tags';
import { PROJECT_CATEGORIES } from '../../content.config';

const projects = await getPublishedProjects();

const groups = PROJECT_CATEGORIES.map((category) => ({
  category,
  projects: projects.filter((project) => project.data.category === category),
})).filter((group) => group.projects.length > 0);
---

<BaseLayout
  title="Projects"
  description="Software engineering projects, documented as they're built: problem, solution, architecture, and lessons learned."
>
  <div class="page-container">
    <header class="page-header">
      <h1>Projects</h1>
      <p>
        Each project page covers the problem, the solution, the
        architecture, and what I'd do differently — updated as the work
        progresses, not written after the fact.
      </p>
    </header>

    {
      groups.map(({ category, projects }) => (
        <section class="category-section" id={slugifyTag(category)}>
          <h2>{category}</h2>
          <div class="project-grid">
            {projects.map((project) => <ProjectCard project={project} />)}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 64rem;
    margin-inline: auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .page-header {
    margin-bottom: 2rem;
    max-width: 40rem;
  }

  .page-header h1 {
    margin: 0 0 0.5rem 0;
    font-size: 1.75rem;
  }

  .page-header p {
    margin: 0;
    color: var(--color-fg-muted);
  }

  .category-section {
    margin-bottom: 2.5rem;
    scroll-margin-top: 5rem;
  }

  .category-section h2 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-fg-muted);
    margin: 0 0 1rem 0;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 24rem));
    gap: 1.25rem;
  }
</style>
