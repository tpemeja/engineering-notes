---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/content/ProjectCard.astro';
import HomeSection from '../components/content/HomeSection.astro';
import { getPublishedProjects, getPublishedNotes } from '../lib/collections';
import { formatDateShort } from '../lib/dates';
import { profile, site } from '../data/site';
import { experience } from '../data/experience';

const [projects, notes] = await Promise.all([getPublishedProjects(), getPublishedNotes()]);

const featuredProjects = profile.featuredProjects
  .map((slug) => projects.find((project) => project.id === slug))
  .filter((project) => project !== undefined);

// The stacked screenshots beside the intro: the first three featured covers,
// front to back.
const heroShots = featuredProjects
  .map((project) => project.data.cover)
  .filter((cover) => cover !== undefined)
  .slice(0, 3);

const latestNotes = notes.slice(0, 4);

const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<BaseLayout title={site.title} description={site.description}>
  <div class="page-container">
    <section class="hero">
      <div class="hero-text">
        <p class="eyebrow">{profile.role}</p>
        <h1>{site.author}</h1>
        <p class="hero-pitch">{profile.pitch}</p>
        <p class="hero-location">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21Z" />
            <circle cx="12" cy="9.5" r="2.5" />
          </svg>
          {profile.location}
        </p>
        <div class="hero-actions">
          <a href="#work" class="button button-primary">See my work</a>
          <a href="/resume/" class="button">Resume</a>
          <span class="hero-socials">
            <a href={site.socials.github} rel="noopener noreferrer" target="_blank">GitHub</a>
            <a href={site.socials.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
            <a href={`mailto:${site.socials.email}`}>Email</a>
          </span>
        </div>
      </div>

      {
        heroShots.length > 0 && (
          <div class="hero-shots" aria-hidden="true">
            {heroShots.map((shot, index) => (
              <img
                src={shot.src}
                alt=""
                class="hero-shot"
                data-layer={index}
                width="1600"
                height="1000"
                decoding="async"
                fetchpriority={index === 0 ? 'high' : undefined}
              />
            ))}
          </div>
        )
      }
    </section>

    <ul class="proof">
      {
        profile.proof.map(({ headline, detail, href }) => (
          <li>
            <a
              href={href}
              class="proof-tile"
              {...(isExternal(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class="proof-headline">
                {headline}
                <span class="proof-arrow" aria-hidden="true">{isExternal(href) ? '↗' : '→'}</span>
              </span>
              <span class="proof-detail">{detail}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <HomeSection title="Selected work" href="/projects/" linkLabel={`All ${projects.length} projects`} id="work">
      <div class="work-grid">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </HomeSection>

    <div class="home-columns">
      <HomeSection title="Experience" href="/resume/" linkLabel="Full resume">
        <ol class="experience">
          {
            experience.map(({ role, company, location, dates }) => (
              <li>
                <div class="experience-role">
                  <strong>{role}</strong>
                  <span>
                    {company} · {location}
                  </span>
                </div>
                <span class="experience-dates">{dates}</span>
              </li>
            ))
          }
        </ol>
      </HomeSection>

      {
        latestNotes.length > 0 && (
          <HomeSection title="Latest notes" href="/notes/" linkLabel={`All ${notes.length} notes`}>
            <ul class="writing">
              {latestNotes.map((note) => (
                <li>
                  <a href={`/notes/${note.id}/`}>
                    <span class="writing-meta">
                      <span class="writing-kind">{note.data.category}</span>
                      <time datetime={note.data.lastUpdated.toISOString()}>{formatDateShort(note.data.lastUpdated)}</time>
                    </span>
                    <span class="writing-title">{note.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </HomeSection>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 72rem;
    margin-inline: auto;
    padding: 3rem 1.5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* Intro */

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: 3rem;
  }

  .eyebrow {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }

  .hero h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .hero-pitch {
    margin: 0 0 1rem;
    max-width: 34rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-fg-muted);
  }

  .hero-location {
    margin: 0 0 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9375rem;
    color: var(--color-fg-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .hero-socials {
    display: flex;
    gap: 1rem;
    font-size: 0.9375rem;
  }

  .hero-socials a {
    color: var(--color-fg-muted);
  }

  .hero-socials a:hover {
    color: var(--color-accent);
  }

  .hero-shots {
    position: relative;
    aspect-ratio: 5 / 4;
  }

  .hero-shot {
    position: absolute;
    width: 78%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background-color: var(--color-bg-subtle);
    box-shadow: 0 24px 48px -24px color-mix(in oklab, var(--color-fg) 45%, transparent);
  }

  .hero-shot[data-layer='0'] {
    left: 0;
    bottom: 0;
    z-index: 3;
  }

  .hero-shot[data-layer='1'] {
    right: 0;
    top: 22%;
    z-index: 2;
    transform: rotate(2deg);
  }

  .hero-shot[data-layer='2'] {
    left: 10%;
    top: 0;
    z-index: 1;
    transform: rotate(-2deg);
    opacity: 0.9;
  }

  /* Proof */

  .proof {
    list-style: none;
    margin: -1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .proof li {
    display: flex;
  }

  .proof-tile {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    background-color: var(--color-bg-subtle);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .proof-tile:hover {
    border-color: var(--color-accent);
  }

  .proof-headline {
    font-size: 1.0625rem;
    font-weight: 650;
  }

  .proof-arrow {
    margin-inline-start: 0.3rem;
    font-size: 0.875rem;
    color: var(--color-accent);
  }

  .proof-detail {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-fg-muted);
  }

  /* Work */

  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  /* Experience and writing */

  .home-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem;
  }

  .experience {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .experience li {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0 0 1.1rem 1.25rem;
  }

  .experience li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    border: 2px solid var(--color-accent);
    background-color: var(--color-bg);
  }

  .experience li:first-child::before {
    background-color: var(--color-accent);
  }

  .experience li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(0.25rem - 0.5px);
    top: 1.1rem;
    bottom: 0.15rem;
    width: 1px;
    background-color: var(--color-border);
  }

  .experience-role {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .experience-role strong {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .experience-role span {
    font-size: 0.875rem;
    color: var(--color-fg-muted);
  }

  .experience-dates {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-fg-muted);
  }

  .writing {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .writing li + li {
    border-top: 1px solid var(--color-border);
  }

  .writing a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.7rem 0;
    color: inherit;
    text-decoration: none;
  }

  .writing li:first-child a {
    padding-top: 0;
  }

  .writing a:hover .writing-title {
    color: var(--color-accent);
  }

  .writing-meta {
    display: flex;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-fg-muted);
  }

  .writing-kind {
    color: var(--color-accent);
  }

  .writing-title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .hero-shots {
      max-width: 32rem;
    }

    .proof {
      margin-top: 0;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-columns {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .page-container {
      padding-top: 2rem;
      gap: 2.75rem;
    }

    .work-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
