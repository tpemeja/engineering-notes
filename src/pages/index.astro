---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/content/ProjectCard.astro';
import JournalEntryCard from '../components/content/JournalEntryCard.astro';
import NoteCard from '../components/content/NoteCard.astro';
import HomeSection from '../components/content/HomeSection.astro';
import { getPublishedProjects, getPublishedJournalEntries, getPublishedNotes } from '../lib/collections';
import { site } from '../data/site';

const [projects, journalEntries, notes] = await Promise.all([
  getPublishedProjects(),
  getPublishedJournalEntries(),
  getPublishedNotes(),
]);

const featuredProjects = projects.slice(0, 2);
const recentJournal = journalEntries.slice(0, 3);
const recentNotes = notes.slice(0, 4);

const publicSinceYear = Math.min(...projects.map((project) => project.data.startDate.getFullYear()));
const currentProject = projects.find((project) => project.data.status === 'active');
---

<BaseLayout title={site.title} description={site.description}>
  <div class="page-container">
    <section class="intro">
      <p class="eyebrow">{site.tagline}</p>
      <h1>{site.author}</h1>
      <p class="intro-description">{site.description}</p>
      <p class="intro-links">
        <a href="/now/">What I'm doing now</a>
        <span aria-hidden="true">·</span>
        <a href="/about/">About</a>
      </p>
      <dl class="stat-strip">
        <div class="stat-tile">
          <dt>Projects</dt>
          <dd><a href="/projects/">{projects.length}</a></dd>
        </div>
        <div class="stat-tile">
          <dt>Public since</dt>
          <dd>{publicSinceYear}</dd>
        </div>
        {
          currentProject && (
            <div class="stat-tile stat-tile-accent">
              <dt>Now building</dt>
              <dd><a href={`/projects/${currentProject.id}/`}>{currentProject.data.title}</a></dd>
            </div>
          )
        }
      </dl>
    </section>

    {
      featuredProjects.length > 0 && (
        <HomeSection title="Featured projects" href="/projects/" linkLabel="All projects">
          <div class="project-grid">
            {featuredProjects.map((project) => <ProjectCard project={project} />)}
          </div>
        </HomeSection>
      )
    }

    {
      recentJournal.length > 0 && (
        <HomeSection title="Recent journal entries" href="/journal/" linkLabel="All entries">
          <div class="journal-list">
            {recentJournal.map((entry) => <JournalEntryCard entry={entry} />)}
          </div>
        </HomeSection>
      )
    }

    {
      recentNotes.length > 0 && (
        <HomeSection title="Recent notes" href="/notes/" linkLabel="All notes">
          <div class="note-grid">
            {recentNotes.map((note) => <NoteCard note={note} />)}
          </div>
        </HomeSection>
      )
    }
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 64rem;
    margin-inline: auto;
    padding: 2.5rem 1.5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .intro {
    max-width: 40rem;
  }

  .eyebrow {
    margin: 0 0 0.4rem 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent);
  }

  .intro h1 {
    margin: 0 0 0.75rem 0;
    font-size: 2rem;
  }

  .intro-description {
    margin: 0 0 0.9rem 0;
    color: var(--color-fg-muted);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .intro-links {
    margin: 0 0 1.5rem 0;
    display: flex;
    gap: 0.6rem;
    font-size: 0.9375rem;
  }

  .intro-links a {
    color: var(--color-accent);
  }

  .stat-strip {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .stat-tile {
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    background-color: var(--color-bg-subtle);
    padding: 0.65rem 1rem;
    min-width: 8rem;
  }

  .stat-tile-accent {
    border-color: var(--color-accent);
  }

  .stat-tile dt {
    margin: 0 0 0.2rem 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-fg-muted);
  }

  .stat-tile dd {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .stat-tile dd a {
    color: inherit;
    text-decoration: none;
  }

  .stat-tile dd a:hover {
    color: var(--color-accent);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 24rem));
    gap: 1.25rem;
  }

  .note-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 20rem));
    gap: 1rem;
  }
</style>
