---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/content/Prose.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import TagList from '../components/content/TagList.astro';
import RelatedContent from '../components/content/RelatedContent.astro';
import { formatDate } from '../lib/dates';
import { getEntries } from 'astro:content';
import { getPublishedProjects } from '../lib/collections';
import { slugifyTag } from '../lib/tags';

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { title, summary, category, tags, lastUpdated, status } = note.data;
const categoryAnchor = `/notes/#${slugifyTag(category)}`;

const relatedNotes = note.data.relatedNotes.length ? await getEntries(note.data.relatedNotes) : [];
// A project lists its notes in relatedNotesSlugs; the note links back from that.
const relatedProjects = (await getPublishedProjects()).filter((project) =>
  project.data.relatedNotesSlugs.some((ref) => ref.id === note.id)
);
---

<BaseLayout title={title} description={summary} ogImagePath={`/open-graph/notes/${note.id}.png`} type="article">
  <article class="page-container">
    <header class="note-header">
      <p class="note-meta">
        <a href={categoryAnchor}>{category}</a>
        <span aria-hidden="true">·</span>
        <StatusBadge status={status} />
        <span aria-hidden="true">·</span>
        <span>Updated {formatDate(lastUpdated)}</span>
      </p>
      <h1>{title}</h1>
      <TagList tags={tags} size="md" />
    </header>

    <Prose>
      <slot />
    </Prose>

    <RelatedContent title="Related" projects={relatedProjects} notes={relatedNotes} />
  </article>
</BaseLayout>

<style>
  .page-container {
    max-width: 42rem;
    margin-inline: auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .note-header {
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .note-meta {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
  }

  .note-meta a {
    color: var(--color-accent);
  }

  .note-header h1 {
    margin: 0;
    font-size: 1.6rem;
  }
</style>
