---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/content/Prose.astro';
import TagList from '../components/content/TagList.astro';
import RelatedContent from '../components/content/RelatedContent.astro';
import { formatDate } from '../lib/dates';
import { getEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'journal'>;
}

const { entry } = Astro.props;
const { title, summary, date, period, tags, relatedProjectSlug } = entry.data;

const relatedProject = relatedProjectSlug ? await getEntry(relatedProjectSlug) : undefined;
---

<BaseLayout title={title} description={summary} ogImagePath={`/open-graph/journal/${entry.id}.png`} type="article">
  <article class="page-container">
    <header class="journal-header">
      <p class="journal-meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{period}</span>
      </p>
      <h1>{title}</h1>
      <TagList tags={tags} size="md" />
    </header>

    <Prose>
      <slot />
    </Prose>

    <RelatedContent title="Related project" projects={relatedProject ? [relatedProject] : []} />
  </article>
</BaseLayout>

<style>
  .page-container {
    max-width: 42rem;
    margin-inline: auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .journal-header {
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .journal-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .journal-header h1 {
    margin: 0;
    font-size: 1.6rem;
  }
</style>
