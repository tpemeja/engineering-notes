---
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/content/Prose.astro';
import { formatDate } from '../lib/dates';

interface Props {
  title: string;
  description: string;
  updatedDate?: Date;
  ogImagePath?: string;
  wide?: boolean;
}

const { title, description, updatedDate, ogImagePath, wide = false } = Astro.props;
---

<BaseLayout title={title} description={description} ogImagePath={ogImagePath}>
  <div class="page-container" data-wide={wide}>
    <header class="page-header">
      <div class="page-header-top">
      {updatedDate && <p class="updated-date">Last updated {formatDate(updatedDate)}</p>}
        <slot name="header-action" />
      </div>
    </header>
    <Prose>
      <slot />
    </Prose>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 42rem;
    margin-inline: auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .page-container[data-wide='true'] {
    max-width: 64rem;
  }

  .page-header-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .page-header-top h1 {
    margin: 0;
    font-size: 1.75rem;
  }

  .updated-date {
    margin: 0.4rem 0 0 0;
    font-size: 0.875rem;
    color: var(--color-fg-muted);
  }
</style>
