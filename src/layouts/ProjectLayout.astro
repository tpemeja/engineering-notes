---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/content/Prose.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import TagList from '../components/content/TagList.astro';
import RelatedContent from '../components/content/RelatedContent.astro';
import ProjectHighlights from '../components/content/ProjectHighlights.astro';
import { getEntries } from 'astro:content';
import { getJournalEntriesForProject } from '../lib/collections';
import { slugifyTag } from '../lib/tags';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, category, active, startDate, technologies, githubUrl, websiteUrl, highlights } =
  project.data;
const started = startDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });

const relatedNotes = project.data.relatedNotesSlugs.length
  ? await getEntries(project.data.relatedNotesSlugs)
  : [];
const relatedJournal = await getJournalEntriesForProject(project.id);
---

<BaseLayout title={title} description={description} ogImagePath={`/open-graph/projects/${project.id}.png`} type="article">
  <article class="page-container">
    <header class="project-header">
      <p class="project-breadcrumb">
        <a href="/projects/">Projects</a>
        <span aria-hidden="true">/</span>
        <a href={`/projects/#${slugifyTag(category)}`}>{category}</a>
      </p>
      <div class="project-header-top">
        <h1>{title}</h1>
        {active && <StatusBadge status="active" />}
      </div>
      <p class="project-description">{description}</p>
      <div class="project-actions">
        {
          websiteUrl && (
            <a href={websiteUrl} class="button button-primary" rel="noopener noreferrer" target="_blank">
              Live at {new URL(websiteUrl).hostname} &#8599;
            </a>
          )
        }
        {
          githubUrl && (
            <a href={githubUrl} class={websiteUrl ? 'button' : 'button button-primary'} rel="noopener noreferrer" target="_blank">
              Source on GitHub &#8599;
            </a>
          )
        }
        <span class="project-started">Started {started}</span>
      </div>
      <TagList tags={technologies} size="md" />
    </header>

    <ProjectHighlights highlights={highlights} />

    <Prose>
      <slot />
    </Prose>

    <RelatedContent title="Related" notes={relatedNotes} journal={relatedJournal} />
  </article>
</BaseLayout>

<style>
  .page-container {
    max-width: 64rem;
    margin-inline: auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .project-header {
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .project-breadcrumb {
    margin: 0;
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-fg-muted);
  }

  .project-breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .project-breadcrumb a:hover {
    color: var(--color-accent);
  }

  .project-header-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-header-top h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .project-description {
    margin: 0;
    max-width: 48rem;
    color: var(--color-fg-muted);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    padding-block: 0.25rem;
  }

  .project-started {
    font-size: 0.875rem;
    color: var(--color-fg-muted);
  }
</style>
